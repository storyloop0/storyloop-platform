{
  "environment": "online",
  "storage": {
    "driver": "postgresql",
    "url_env": "DATABASE_URL"
  },
  "player_memory": {
    "driver": "mem0",
    "enabled_env": "STORY_PLAYER_MEMORY_ENABLED",
    "path_env": "STORY_MEMORY_DIR",
    "extraction_profile": "memory_extraction",
    "embedding_profile": "memory_embedding",
    "generated_preference_max_age_days": 90
  },
  "http": {
    "allowed_hosts_env": "STORY_ALLOWED_HOSTS",
    "allowed_origins_env": "STORY_ALLOWED_ORIGINS"
  }
}
